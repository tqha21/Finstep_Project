# Copy to ops/staging/.env; never commit real credentials.
STAGING_HOST=localhost
# internal -> local CA. For Internet staging: ops@example.com (ACME account email).
TLS_ISSUER=internal
STAGING_BIND_ADDRESS=127.0.0.1
STAGING_HTTP_PORT=8088
STAGING_HTTPS_PORT=8443
PROMETHEUS_PORT=9091
POSTGRES_DB=finstep
POSTGRES_USER=finstep
POSTGRES_PASSWORD=replace-with-a-long-random-password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
MAIL_FROM=finstep@example.com
SMTP_AUTH=true
SMTP_STARTTLS=true
# Keep these three values consistent; trust only Caddy's private address.
STAGING_SUBNET=10.77.0.0/24
CADDY_IP=10.77.0.10
TRUSTED_PROXY_REGEX=10\.77\.0\.10

# Optional profiles. Fill/review these before using --profile alerting --profile offsite.
# UID/GID must match the owner of the private files/state directory (id -u / id -g).
ALERTMANAGER_UID=1000
ALERTMANAGER_GID=1000
ALERTMANAGER_CONFIG_FILE=/secure/finstep/alertmanager.generated.json
ALERTMANAGER_TOKEN_FILE=/secure/finstep/alert-webhook-token
ALERTMANAGER_STATE_DIR=/var/lib/finstep/alertmanager-data
BACKUP_STORE_CONFIG=/secure/finstep/rclone.conf
BACKUP_REMOTE=offsite:replace-bucket/finstep-staging
BACKUP_RECIPIENT_CERT=/secure/finstep/backup-recipient.crt
BACKUP_METRICS_DIR=/var/lib/finstep/backup-metrics
