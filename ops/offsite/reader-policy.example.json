{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect":"Allow","Action":["s3:GetBucketLocation"],"Resource":"arn:aws:s3:::REPLACE_BUCKET"},
    {"Effect":"Allow","Action":["s3:ListBucket"],"Resource":"arn:aws:s3:::REPLACE_BUCKET","Condition":{"StringLike":{"s3:prefix":["finstep-staging","finstep-staging/*"]}}},
    {"Effect":"Allow","Action":["s3:GetObject"],"Resource":"arn:aws:s3:::REPLACE_BUCKET/finstep-staging/*"}
  ]
}
