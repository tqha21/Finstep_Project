[Unit]
Description=Encrypted Finstep PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/finstep
UMask=0077
# Review the container name, destination and public recipient certificate before installing.
ExecStart=/usr/bin/bash /opt/finstep/scripts/backup-db.sh finstep-staging-db-1 /var/lib/finstep/backups /etc/finstep/backup-recipient.crt
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/finstep/backups
